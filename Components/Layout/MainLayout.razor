@inherits LayoutComponentBase

<div class="bg-light min-vh-100 d-flex flex-column">
    <nav class="navbar navbar-expand-md navbar-dark shadow-sm w-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-bottom: none;">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="navbar-brand fw-bold mb-0">
                <i class="bi bi-calculator-fill me-2"></i> Prueba Técnica - Súper Dígito
            </span>
            
            <form method="post" action="/api/auth/logout" data-enhance="false" class="m-0">
                <button type="submit" class="btn btn-outline-light btn-sm fw-bold">Cerrar Sesión</button>
            </form>
        </div>
    </nav>

    <main class="container py-5 flex-grow-1">
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
